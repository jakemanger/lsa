#!/usr/bin/env bash
# lsa - ls for agent sessions.
# https://github.com/jakemanger/lsa
set -eu

VERSION="0.1.0"

usage() {
  cat <<'EOF'
lsa - ls for agent sessions

usage: lsa [options] [dir]          list sessions started in dir (default: .)
       lsa show <id>                print a transcript as plain text
       lsa handoff <id> <agent> [options...]  continue in claude, codex or pi
       lsa path <id>                print where the transcript lives
       lsa resume <id>              reopen the session in its own agent

options:
  -a, --all           every directory, not just dir
  -t, --agent NAME    only this agent (repeatable): claude codex pi gemini
                      qwen cline opencode goose muse openclaw
  -n, --limit N       show at most N sessions
  -l, --long          add full directory and transcript path columns
  -h, --help          this text
  -V, --version       version

<id> is the index or the short id from the listing, or any unique prefix
of the full id. Index 0 is the newest session; indexes are global, so
lsa resume 3 is the same session whether you listed with -a or not.
EOF
}

# ---------- where each agent keeps its sessions ----------
XDG_DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
GEMINI_HOME="${GEMINI_CLI_HOME:-$HOME/.gemini}"
ROOTS="claude	${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects
codex	${CODEX_HOME:-$HOME/.codex}/sessions
pi	${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/sessions
gemini	$GEMINI_HOME/tmp
qwen	$HOME/.qwen/projects
cline	$HOME/.cline/data/sessions"
DB_OPENCODE="$XDG_DATA/opencode/opencode.db"
DB_GOOSE="$XDG_DATA/goose/sessions/sessions.db"
DB_MUSE="$XDG_DATA/muse/session-index.db"
DB_OPENCLAW_GLOB="$HOME/.openclaw/agents/*/agent/openclaw-agent.sqlite"

color_of() { # agent -> sets COLOR
  case $1 in
    claude) COLOR=$'\033[38;5;208m';; codex) COLOR=$'\033[38;5;39m';;
    pi) COLOR=$'\033[38;5;141m';;     gemini) COLOR=$'\033[38;5;75m';;
    qwen) COLOR=$'\033[38;5;135m';;   opencode) COLOR=$'\033[38;5;114m';;
    goose) COLOR=$'\033[38;5;220m';;  cline) COLOR=$'\033[38;5;45m';;
    muse) COLOR=$'\033[38;5;204m';;   openclaw) COLOR=$'\033[38;5;173m';;
    *) COLOR='';;
  esac
  [ "$USE_COLOR" = 1 ] || COLOR=''
}
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then USE_COLOR=1 C_DIM=$'\033[2m' C_WORK=$'\033[32m' C_RESET=$'\033[0m' MARK='●'
else USE_COLOR=0 C_DIM='' C_WORK='' C_RESET='' MARK='▶'; fi

resume_cmd() { # agent id file cwd -> sets RESUME ("" when the agent has no resume command)
  case $1 in
    claude)   RESUME="claude --resume $2";;
    codex)    RESUME="codex resume $2";;
    pi)       RESUME="pi --session $3";;
    gemini)   RESUME="gemini --resume $2";;
    qwen)     RESUME="qwen --resume $2";;
    cline)    RESUME="cline -i --id $2";;
    opencode) RESUME="opencode --session $2";;
    goose)    RESUME="goose session --resume --session-id $2";;
    muse)     RESUME="muse resume $2";;
    openclaw) RESUME="openclaw tui --session agent:$4";;   # the "directory" column holds the session key
    *)        RESUME="";;
  esac
}

NOW=$(date +%s)
ago() { # seconds since epoch -> sets AGO to "3m ago" (no subshell: called per row)
  local d=$(( NOW - $1 ))
  if   [ "$d" -lt 60 ];     then AGO="${d}s ago"
  elif [ "$d" -lt 3600 ];   then AGO="$((d/60))m ago"
  elif [ "$d" -lt 86400 ];  then AGO="$((d/3600))h ago"
  elif [ "$d" -lt 2592000 ]; then AGO="$((d/86400))d ago"
  else AGO="$((d/2592000))mo ago"; fi
}

# stdin: NUL-separated paths -> "mtime<TAB>path" per line, one stat call
mtimes() {
  if stat -f %m / >/dev/null 2>&1; then xargs -0 stat -f "%m"$'\t'"%N" 2>/dev/null
  else xargs -0 stat -c "%Y"$'\t'"%n" 2>/dev/null; fi
  return 0
}

HIDDEN='[lsa:hidden]'   # title sentinel for files that are not sessions
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/lsa"
CACHE="$CACHE_DIR/index-$VERSION.tsv"

# parser: agent path mtime -> path cwd title id (tab-separated; id overrides the filename)
parse() {
  awk -F '\t' -v now="$NOW" -v HIDDEN="$HIDDEN" -v gemini_projects="$GEMINI_HOME/projects.json" '
    function jstr(s,   out) {
      match(s, /^([^"\\]|\\.)*/); out = substr(s, 1, RLENGTH)
      gsub(/\\[ntr]/, " ", out); gsub(/\\"/, "\"", out); gsub(/\\\\/, "\\", out)
      return substr(out, 1, 300) }
    function val(line, key) {
      if (match(line, "\"" key "\"[ \t]*:[ \t]*\"")) return jstr(substr(line, RSTART + RLENGTH, 2000))
      return "" }
    function has(line, key, value) { return match(line, "\"" key "\"[ \t]*:[ \t]*\"" value "\"") }
    function text_of(line,   t) { t = val(line, "text"); if (t == "") t = val(line, "content"); return t }
    BEGIN {  # Gemini names project dirs by a short id; projects.json maps paths to them
      while ((getline line < gemini_projects) > 0)
        if (match(line, /"\/[^"]*"[ \t]*:[ \t]*"[^"]+"/)) {
          split(substr(line, RSTART, RLENGTH), kv, /"[ \t]*:[ \t]*"/)
          gsub(/"/, "", kv[1]); gsub(/"/, "", kv[2]); gemini_dir[kv[2]] = kv[1] }
      close(gemini_projects) }
    { agent = $1; f = $2; cwd = ""; title = ""; id = ""; n = 0; cont = 0; pend = 0
      while ((getline line < f) > 0) {
        if (++n > 60) break
        if (agent == "claude" || agent == "qwen") {
          if (cwd == "") cwd = val(line, "cwd")
          if (title == "" && has(line, "type", "user")) title = text_of(line) }
        else if (agent == "codex") {
          # internal reviewer threads share the session store
          if (n == 1 && has(line, "thread_source", "guardian_review")) { title = HIDDEN; break }
          if (cwd == "") cwd = val(line, "cwd")
          if (has(line, "type", "compacted")) cont = 1
          if (title == "" && has(line, "role", "user")) { t = text_of(line)
            # skip injected context when choosing a title
            if (t !~ /^(<|# AGENTS\.md|The following is the Codex agent history)/) title = t } }
        else if (agent == "pi") {
          if (cwd == "") cwd = val(line, "cwd")
          if (title == "" && has(line, "role", "user")) title = text_of(line) }
        else if (agent == "gemini") {
          if (n == 1) { id = val(line, "sessionId")
            nparts = split(f, parts, "/"); cwd = gemini_dir[parts[nparts - 2]] }
          if (title == "" && has(line, "type", "user")) title = text_of(line) }
        else if (agent == "cline") {
          if (cwd == "") cwd = val(line, "cwd")
          if (title == "") title = val(line, "prompt") }
        if (title != "" && (cwd != "" || agent == "gemini")) break }
      close(f)
      if (title == "" && cont) title = "(continued after compaction)"
      # retry empty sessions for ten minutes before caching them
      if (title != "" || now - $3 > 600) { gsub(/\t/, " ", title); print f "\t" cwd "\t" title "\t" id } }'
}

# database rows: mtime agent db id directory title (tab-separated)
db_rows() {
  command -v sqlite3 >/dev/null || return 0
  local db q
  san() { printf "replace(replace(substr(%s, 1, 300), char(9), ' '), char(10), ' ')" "$1"; }
  if [ -f "$DB_OPENCODE" ]; then
    q=$(san "title")
    sqlite3 -batch -readonly -separator '	' "$DB_OPENCODE" "select time_updated/1000, 'opencode', '$DB_OPENCODE', id, directory, $q
      from session where time_archived is null and parent_id is null" 2>/dev/null
  fi
  if [ -f "$DB_GOOSE" ]; then
    q=$(san "coalesce((select json_extract(m.content_json, '\$[0].text') from messages m where m.session_id = s.id and m.role = 'user' order by m.id limit 1), nullif(s.description, ''), s.name)")
    sqlite3 -batch -readonly -separator '	' "$DB_GOOSE" "select cast(strftime('%s', updated_at) as integer), 'goose', '$DB_GOOSE', id, working_dir, $q
      from sessions s where session_type = 'user'" 2>/dev/null
  fi
  if [ -f "$DB_MUSE" ]; then
    q=$(san "coalesce(nullif(first_user_prompt, ''), title)")
    sqlite3 -batch -readonly -separator '	' "$DB_MUSE" "select updated_at_us/1000000, 'muse', '$DB_MUSE', session_id, coalesce(workspace_root, ''), $q
      from sessions where status = 'valid'" 2>/dev/null
  fi
  for db in $DB_OPENCLAW_GLOB; do
    [ -f "$db" ] || continue
    q=$(san "coalesce((select coalesce(json_extract(e.event_json, '\$.message.content[0].text'), json_extract(e.event_json, '\$.message.content')) from transcript_events e where e.session_id = w.session_id and json_extract(e.event_json, '\$.type') = 'message' and json_extract(e.event_json, '\$.message.role') = 'user' order by e.seq limit 1), nullif(w.display_name, ''), '')")
    sqlite3 -batch -readonly -separator '	' "$db" "select w.updated_at/1000, 'openclaw', '$db', w.session_id, substr(w.session_key, 7), $q
      from session_windows w" 2>/dev/null
  done
  return 0
}

find_files() {
  local roots=() root agent
  while IFS=$'\t' read -r agent root; do [ -d "$root" ] && roots+=("$root"); done <<< "$ROOTS"
  [ ${#roots[@]} -gt 0 ] || return 0
  find "${roots[@]}" -type f \( -name '*.jsonl' -o -name '*.json' \) ! -name 'agent-*' ! -name '*.messages.json' -print0 2>/dev/null | mtimes
}

# stdin: "mtime<TAB>path" for files, or six-column rows from db_rows.
join_cache() { # missfile
  # awk -v expands \n, and BSD awk rejects a literal newline, so escape them
  awk -F '\t' -v OFS='\t' -v c="$CACHE" -v roots="${ROOTS//$'\n'/\\n}" -v miss="$1" '
    BEGIN { nr = split(roots, r, "\n"); for (i = 1; i <= nr; i++) { split(r[i], p, "\t"); ra[i] = p[1]; rp[i] = p[2] "/" } }
    FILENAME == c { cwd[$1] = $2; title[$1] = $3; if ($4 != "") fullid[$1] = $4; next }
    NF >= 6 { k++; ts[k] = $1; ag[k] = $2; path[k] = $3; id[k] = $4; dcwd[k] = $5; dtitle[k] = $6; fromdb[k] = 1
              for (L = 4; L <= length(id[k]); L++) seen[substr(id[k], 1, L)]++; next }
    { f = $2; agent = ""
      for (i = 1; i <= nr; i++) if (index(f, rp[i]) == 1) { agent = ra[i]; break }
      if (agent == "") next
      base = f; sub(/.*\//, "", base)
      if (agent == "codex") { if (base !~ /^rollout-.*\.jsonl$/) next
        sub(/^rollout-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}-/, "", base) }
      else if (agent == "pi") sub(/^[^_]*_/, "", base)
      else if (agent == "gemini") { if (f !~ /\/chats\/session-.*\.jsonl$/) next
        sub(/\.jsonl$/, "", base); sub(/.*-/, "", base) }
      else if (agent == "cline") { dir = f; sub(/\/[^\/]*$/, "", dir); sub(/.*\//, "", dir)
        if (base != dir ".json") next }
      else if (base !~ /\.jsonl$/) next
      sub(/\.jsonl?$/, "", base)
      if (f in fullid) base = fullid[f]
      k++; ts[k] = $1; ag[k] = agent; path[k] = f; id[k] = base
      for (L = 4; L <= length(base); L++) seen[substr(base, 1, L)]++ }
    END {
      for (i = 1; i <= k; i++) {
        for (L = 4; L < length(id[i]) && seen[substr(id[i], 1, L)] > 1; L++) ;
        # "-" stands for an empty field: bash read collapses adjacent tabs
        if (fromdb[i]) print ts[i], ag[i], path[i], id[i], L, (dcwd[i] == "" ? "-" : dcwd[i]), (dtitle[i] == "" ? "-" : dtitle[i])
        else if (path[i] in title) print ts[i], ag[i], path[i], id[i], L, (cwd[path[i]] == "" ? "-" : cwd[path[i]]), (title[path[i]] == "" ? "-" : title[path[i]])
        else { print ts[i], ag[i], path[i], id[i], L, "-", "-"; print ag[i] "\t" path[i] "\t" ts[i] > miss } } }' "$CACHE" -
}

# sessions: mtime agent path id shortlen cwd title (tab-separated, newest first)
sessions() {
  local files rows miss
  files=$(find_files; db_rows)
  [ -n "$files" ] || return 0
  mkdir -p "$CACHE_DIR"; [ -f "$CACHE" ] || : > "$CACHE"
  miss="$CACHE_DIR/miss.$$"
  rows=$(printf '%s\n' "$files" | join_cache "$miss")
  if [ -s "$miss" ]; then
    parse < "$miss" >> "$CACHE"
    rows=$(printf '%s\n' "$files" | join_cache /dev/null)
  fi
  rm -f "$miss"
  printf '%s\n' "$rows" | sort -rn | awk -F '\t' -v h="$HIDDEN" '$7 != h'
}

want_agent() {
  [ -z "$AGENTS" ] && return 0
  case " $AGENTS " in *" $1 "*) return 0;; esac
  return 1
}

# busy heuristic: recent transcript activity and a running agent process
WORKING_WINDOW=120
running_agents() {
  ps -axo command= 2>/dev/null | awk '
    { cmd = $1; sub(/.*\//, "", cmd)
      if (cmd ~ /^(claude|codex|pi|gemini|qwen|opencode|goose|openclaw)$/) seen[cmd] = 1
      else if (cmd ~ /^muse(-bin.*)?$/) seen["muse"] = 1
      else if (cmd ~ /^\.?cline$/) seen["cline"] = 1
      else if (cmd ~ /^(node|bun|deno)[0-9.]*$/ && $2 ~ /\/(pi|gemini|qwen|openclaw|opencode|cline)$/) { sub(/.*\//, "", $2); seen[$2] = 1 } }
    END { for (a in seen) printf "%s ", a }'
}

# ---------- the pane a session is already open in ----------
agent_pane() { # id -> the pane an agent says it is in, or nothing
  local f
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/sessions/*.json; do
    grep -qs "\"sessionId\":\"$1\"" "$f" || continue
    sed -n 's/.*"tmux":"[^"]*\(%[0-9][0-9]*\)".*/\1/p' "$f"
    return 0
  done
}

agent_pids() { # id -> pids holding the session open, one per line
  lsof -t -- "${CODEX_HOME:-$HOME/.codex}/thread-writer-locks/$1.lock" 2>/dev/null
}

tmux_target() { # id -> pane id, or nothing
  command -v tmux >/dev/null 2>&1 || return 0
  local panes pane pids
  panes=$(tmux list-panes -a -F $'\t#{pane_id}\t#{pane_pid}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0

  pane=$(agent_pane "$1")
  case "$panes" in *"	$pane	"*) [ -n "$pane" ] && { printf '%s\n' "$pane"; return 0; };; esac

  pids=$(agent_pids "$1" | tr '\n' ' ')
  { printf '%s\n' "$panes"; ps -axo pid=,ppid=,command= 2>/dev/null; } | awk -F'\t' -v id="$1" -v pids=" $pids " '
    NF == 3 { pane[$3] = $2; next }
    { n = split($0, f, " ")
      for (i = 1; i <= n; i++) if (f[i] != "") { pid = f[i]; break }
      for (j = i + 1; j <= n; j++) if (f[j] != "") { ppid = f[j]; break }
      parent[pid] = ppid
      if (index($0, id) || index(pids, " " pid " ")) holder[pid] = 1 }
    END { for (p in holder) { q = p
            while (q != "" && q != "1") { if (q in pane) { print pane[q]; exit } q = parent[q] } } }'
}

since_ts() { # agent path id -> last prompt epoch seconds, if available
  local agent=$1 f=$2 id=$3 pat q
  case $agent in
    claude)  pat='"type":"user"' ;;   # also matches tool results; excluded below
    codex)   pat='"role":"user"' ;;
    pi)      pat='"role":"user"' ;;
    qwen)    pat='"type":"user"' ;;
    gemini)  pat='"type":"user"' ;;
    goose)   sqlite3 -batch -readonly "$f" "select max(created_timestamp) from messages where session_id = '$id' and role = 'user'
               and json_extract(content_json, '\$[0].text') not like '<turn-context>%'" 2>/dev/null; return;;
    opencode) sqlite3 -batch -readonly "$f" "select max(json_extract(data, '\$.time.created')) / 1000 from message
               where session_id = '$id' and json_extract(data, '\$.role') = 'user'" 2>/dev/null; return;;
    openclaw) sqlite3 -batch -readonly "$f" "select max(created_at) / 1000 from transcript_events where session_id = '$id'
               and json_extract(event_json, '\$.type') = 'message' and json_extract(event_json, '\$.message.role') = 'user'" 2>/dev/null; return;;
    muse)    f=$(sqlite3 -batch -readonly "$f" "select session_log_path from sessions where session_id = '$id'" 2>/dev/null)
             [ -f "$f" ] || return 0
             tail -c 262144 "$f" | awk '/"kind":"started"/ && match($0, /"recorded_at":[0-9]+/) { t = substr($0, RSTART + 14, RLENGTH - 14) }
               END { if (t != "") print int(t / 1000000) }'; return;;
    *) return 0;;
  esac
  tail -c 262144 "$f" | awk -v pat="$pat" '
    function epoch(s,   y, m, d, H, M, S, a, yy, mm, days) {   # ISO-8601 UTC -> seconds, no mktime in BSD awk
      y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
      H = substr(s, 12, 2) + 0; M = substr(s, 15, 2) + 0; S = substr(s, 18, 2) + 0
      yy = y - (m <= 2); a = int(yy / 400); mm = m + (m > 2 ? -3 : 9)
      days = int((153 * mm + 2) / 5) + d - 1 + 365 * (yy - 400 * a) + int((yy - 400 * a) / 4) - int((yy - 400 * a) / 100) + 146097 * a - 719468
      return days * 86400 + H * 3600 + M * 60 + S }
    index($0, pat) && index($0, "\"text\"") && !index($0, "tool_result") && match($0, /"timestamp":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z"/) {
      t = substr($0, RSTART + 13, RLENGTH - 14) }
    END { if (t != "") print epoch(t) }'
}

busy_for() { # seconds -> sets BUSY like "2m" (no "ago": it is how long, not how long since)
  local d=$1
  if   [ "$d" -lt 60 ];    then BUSY="${d}s"
  elif [ "$d" -lt 3600 ];  then BUSY="$((d/60))m"
  elif [ "$d" -lt 36000 ]; then BUSY="$((d/3600))h$(( (d%3600)/60 ))m"
  else BUSY="$((d/3600))h"; fi
}

# ---------- list ----------
transcript_path() { # agent index-path id -> sets TRANSCRIPT and SHARED
  TRANSCRIPT=$2 SHARED=0
  case $1 in
    cline) TRANSCRIPT="${2%.json}.messages.json";;
    muse) TRANSCRIPT=$(sqlite3 -batch -readonly "$2" "select session_log_path from sessions where session_id = '$3'") ;;
    opencode|goose|openclaw) SHARED=1;;
  esac
}

format_long() {
  awk -F '\t' '
    { prefix[NR] = $1; dir[NR] = $2; id[NR] = $3; path[NR] = $4; title[NR] = $5
      plain = $3; gsub(/\033\[[0-9;]*m/, "", plain); idlen[NR] = length(plain)
      if (length($2) > dw) dw = length($2)
      if (idlen[NR] > iw) iw = idlen[NR]
      if (length($4) > pw) pw = length($4) }
    END { for (i = 1; i <= NR; i++)
      printf "%s %-*s %s%*s %-*s %s\n", prefix[i], dw, dir[i], id[i], iw - idlen[i], "", pw, path[i], title[i] }'
}

list_rows() {
  local dir=$1 cols=$2 shown=0 i=-1 width ts agent f cwd id short n title when proj rows running='' since location
  rows=$(sessions)
  [ -n "$rows" ] || return 0
  [ $(( NOW - ${rows%%	*} )) -lt "$WORKING_WINDOW" ] && running=$(running_agents)
  printf '%s\n' "$rows" | while IFS=$'\t' read -r ts agent f id n cwd title; do
    i=$((i+1))
    want_agent "$agent" || continue
    [ "$cwd" = - ] && cwd=''; [ "$title" = - ] && title=''
    short=${id:0:$n}
    if [ "$ALL" = 0 ] && [ "$cwd" != "$dir" ] && [ "$cwd" != "$DIRP" ]; then continue; fi
    [ -z "$title" ] && title="${C_DIM}(empty)${C_RESET}"
    color_of "$agent"
    ago "$ts"; when=$AGO
    case " $running " in *" $agent "*)
      if [ $(( NOW - ts )) -lt "$WORKING_WINDOW" ]; then
        since=$(since_ts "$agent" "$f" "$id"); BUSY=''
        [ -n "$since" ] && [ "$since" -le "$NOW" ] 2>/dev/null && busy_for $(( NOW - since ))
        when="${C_WORK}${MARK} ${BUSY}${C_RESET}"; when="$when$(printf '%*s' $(( 8 - 2 - ${#BUSY} )) '')"
      fi;;
    esac
    proj=${cwd##*/}; [ -n "$proj" ] || proj='?'
    width=$(( cols - 4 - 9 - 9 - 22 - 10 - 4 ))
    [ "$width" -lt 20 ] && width=20
    case $when in *"$MARK"*) ;; *) when=$(printf '%-8s' "$when");; esac
    if [ "$LONG" = 1 ]; then
      transcript_path "$agent" "$f" "$id"
      location=$TRANSCRIPT
      [ "$SHARED" = 1 ] && location="$location [shared database]"
      printf '%3d %s%-8s%s %s\t%s\t%s%s%s\t%s\t%.*s\n' \
        "$i" "$COLOR" "$agent" "$C_RESET" "$when" "${cwd:--}" "$C_DIM" "$short" "$C_RESET" "$location" "$width" "$title"
    elif [ "$ALL" = 1 ]; then
      printf '%3d %s%-8s%s %s %-20.20s %s%-9s%s %.*s\n' \
        "$i" "$COLOR" "$agent" "$C_RESET" "$when" "$proj" "$C_DIM" "$short" "$C_RESET" "$width" "$title"
    else
      printf '%3d %s%-8s%s %s %s%-9s%s %.*s\n' \
        "$i" "$COLOR" "$agent" "$C_RESET" "$when" "$C_DIM" "$short" "$C_RESET" "$((width+21))" "$title"
    fi
    shown=$((shown+1))
    [ "$LIMIT" -gt 0 ] && [ "$shown" -ge "$LIMIT" ] && break
  done | if [ "$LONG" = 1 ]; then format_long; else cat; fi
  return 0
}

cmd_list() {
  local dir=$1 cols out
  if [ -t 1 ]; then cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}; else cols=200; fi
  out=$(list_rows "$dir" "$cols")
  if [ -n "$out" ]; then printf '%s\n' "$out"
  elif [ "$ALL" = 1 ]; then echo "lsa: no sessions found" >&2
  else echo "lsa: no sessions in $dir (try lsa -a)" >&2; fi
  return 0
}

find_one() { # index or id prefix -> agent<TAB>id<TAB>path<TAB>cwd
  local prefix=$1 hits n
  case $prefix in
    [0-9]|[0-9][0-9]|[0-9][0-9][0-9])
      hits=$(sessions | awk -F '\t' -v OFS='\t' -v n="$((prefix+1))" 'NR == n { print $2, $4, $3, $6 }')
      [ -n "$hits" ] || { echo "lsa: no session at index $prefix" >&2; return 1; }
      printf '%s\n' "$hits"; return 0;;
  esac
  hits=$(sessions | awk -F '\t' -v OFS='\t' -v p="$prefix" 'index($4, p) == 1 { print $2, $4, $3, $6 }')
  n=$(printf '%s' "$hits" | grep -c .)
  case $n in
    0) echo "lsa: no session starts with '$prefix'" >&2; return 1;;
    1) printf '%s\n' "$hits";;
    *) echo "lsa: '$prefix' is ambiguous:" >&2; printf '%s\n' "$hits" | cut -f2 >&2; return 1;;
  esac
}

# ---------- show: recorded context and transcript as plain text ----------
# shellcheck disable=SC2016
SHOW_JQ='
  def safe:
    walk(if type == "object" then
      del(.encrypted_content, .signature, .thoughtSignature, .thinkingSignature)
      | if .type? == "base64" or has("mimeType") or has("mime_type") or .type? == "image" or .type? == "audio" or .type? == "redacted_thinking"
        then (if has("data") then .data = "[binary data omitted]" else . end)
          | if has("blob") then .blob = "[binary data omitted]" else . end else . end
      else . end)
    | walk(if type == "string" and startswith("data:") then "[embedded attachment omitted]" else . end);
  def text:
    if . == null then ""
    elif type == "string" then safe
    elif type == "array" then map(text) | map(select(length > 0)) | join("\n")
    elif type != "object" then tostring
    elif .type? == "tool_use" or .type? == "toolCall" then
      "[tool: " + (.name // "unknown") + (if .id then " id=" + .id else "" end) + "] " + ((.input // .arguments // {}) | safe | tojson)
    elif .type? == "tool_result" or .type? == "toolResult" then
      "[result" + (if .tool_use_id // .toolCallId then " id=" + (.tool_use_id // .toolCallId) else "" end)
      + (if .is_error // .isError then " error" else "" end) + "]\n" + (.content | text)
    elif has("functionCall") then "[tool: " + .functionCall.name + "] " + (.functionCall.args | safe | tojson)
    elif has("functionResponse") then "[result: " + .functionResponse.name + "]\n" + (.functionResponse.response | text)
    elif .type? == "thinking" then "[thinking]\n" + (.thinking // .text // "")
    elif has("text") then .text | text
    elif .type? == "input_image" or .type? == "image" or .type? == "image_url" or .type? == "document"
      or has("inlineData") or has("fileData") then "[attachment] " + (safe | tojson)
    elif has("content") then .content | text
    else safe | tojson end;
  def turn($role; $body):
    ($body | text) as $t | select($t | length > 0) | "\n## " + $role + "\n" + $t;
  def codex_item:
    if .type == "message" then turn(.role; .content)
    elif .type == "function_call" or .type == "custom_tool_call" then
      turn("assistant"; "[tool: " + .name + " id=" + (.call_id // .id // "unknown") + "]\n" + ((.arguments // .input) | text))
    elif .type == "function_call_output" or .type == "custom_tool_call_output" then
      turn("tool"; "[result id=" + (.call_id // "unknown") + "]\n" + (.output | text))
    elif .type == "reasoning" then turn("reasoning summary"; [.summary, .content])
    elif .type == "compaction" then turn("compaction"; "[Compacted state is encrypted; only recorded text can be exported.]")
    else turn(.type // "event"; .) end;
'

# shellcheck disable=SC2016
show_session() ( # agent id index-path cwd; subshell confines pipefail
  set -o pipefail
  local agent=$1 id=$2 f=$3 cwd=$4 filter
  command -v jq >/dev/null || { echo "lsa: 'show' needs jq (brew install jq / apt install jq)" >&2; return 1; }
  case $agent in
    opencode)
      sqlite3 -batch -readonly "$f" "select json_object('role', json_extract(m.data, '\$.role'), 'part', json(p.data))
        from message m join part p on p.message_id = m.id where m.session_id = '$id'
        order by m.time_created, m.id, p.time_created, p.id" |
        jq -r "$SHOW_JQ"'select(.part.type != "step-start" and .part.type != "step-finish")
          | turn(.role; if .part.type == "tool" then
              "[tool: " + .part.tool + " id=" + (.part.callID // "unknown") + "]\n" + (.part.state | del(.output, .error) | safe | tojson) + "\n" + ([.part.state.output, .part.state.error] | text)
            else .part end)'; return;;
    goose)
      sqlite3 -batch -readonly "$f" "select json_object('role', role, 'content', json(content_json))
        from messages where session_id = '$id' order by id" |
        jq -r "$SHOW_JQ"'turn(.role; .content)'; return;;
    muse)
      f=$(sqlite3 -batch -readonly "$f" "select session_log_path from sessions where session_id = '$id'") || return
      filter='select(.payload_type == "runtime.session") | .payload.event
        | if .kind == "started" then turn("user"; .prompt)
          elif .kind == "assistant_message_committed" then turn("assistant"; .text)
          elif (.kind // "" | test("tool|compact|context")) then turn(.kind; .) else empty end';;
    openclaw)
      sqlite3 -batch -readonly "$f" "select event_json from transcript_events where session_id = '$id' order by seq" |
        jq -r "$SHOW_JQ"'if .type == "message" then turn(.message.role; .message.content)
          elif .type == "compaction" or .type == "branch_summary" then turn(.type; .summary)
          else empty end'; return;;
    claude) filter='
      if .type == "user" or .type == "assistant" then turn(.message.role; .message.content)
      elif .type == "attachment" then
        turn("context (" + (.attachment.type // "attachment") + ")";
          if (.rendered // [] | length) > 0 then .rendered else .attachment end)
      elif .type == "system" then
        if .subtype == "compact_boundary" then turn("compaction"; .compactMetadata // .content // "Context compacted.")
        else turn("system (" + (.subtype // "message") + ")"; .content) end
      elif .type == "summary" then turn("summary"; .summary)
      else empty end';;
    codex) filter='
      if .type == "response_item" then .payload | codex_item
      elif .type == "session_meta" then turn("session context"; .payload | {cwd, git} | with_entries(select(.value != null))),
        turn("recorded instructions"; .payload.base_instructions.text // .payload.base_instructions)
      elif .type == "turn_context" or .type == "world_state" then turn(.type; .payload)
      elif .type == "compacted" then
        turn("compaction summary"; .payload.message),
        (.payload.replacement_history[]? | codex_item),
        turn("retained context"; .payload.retained_context)
      elif .type == "event_msg" and (.payload.type == "turn_aborted" or .payload.type == "error") then turn(.payload.type; .payload)
      else empty end';;
    pi) filter='
      if .type == "message" then .message as $m
        | if $m.role == "toolResult" then turn("tool"; "[result: " + ($m.toolName // "unknown") + " id=" + ($m.toolCallId // "unknown") + (if $m.isError then " error" else "" end) + "]\n" + ($m.content | text))
          elif $m.role == "bashExecution" then turn("bash"; $m | {command, output, exitCode, cancelled, truncated, fullOutputPath})
          else turn($m.role; $m.content) end
      elif .type == "session" then turn("session context"; {cwd, parentSession} | with_entries(select(.value != null)))
      elif .type == "compaction" or .type == "branch_summary" then turn(.type; .summary)
      elif .type == "custom_message" then turn("context (" + (.customType // "custom") + ")"; .content)
      else empty end';;
    qwen) filter='
      if .type == "user" or .type == "assistant" then turn(.type; .message.parts)
      elif .type == "system" and (.subtype // "" | test("compact|summary")) then turn(.subtype; .systemPayload)
      else empty end';;
    gemini) filter='
      if .type == "user" or .type == "gemini" or .type == "system" then
        turn(.type; [.content, (.toolCalls[]? | "[tool: " + (.name // "unknown") + "]\n" + (safe | tojson))])
      else empty end';;
    cline) f="${f%.json}.messages.json"; filter='
      .messages[] | turn(.role; (.content | text | sub("^<user_input[^>]*>"; "") | sub("</user_input>$"; "")))';;
    *) echo "lsa: show does not know the $agent format yet; the session is at" >&2; echo "$f" >&2; return 1;;
  esac
  jq -r "$SHOW_JQ$filter" "$f"
)

cmd_show() {
  local hit agent id f cwd
  hit=$(find_one "$1") || return
  IFS=$'\t' read -r agent id f cwd <<< "$hit"
  show_session "$agent" "$id" "$f" "$cwd"
}

handoff_codex() (
  local directory=$1 snapshot=$2 server='' reply step id
  umask 077
  mkfifo "$directory/input" "$directory/output" || return
  trap 'exec 3>&- 4<&-; if [ -n "$server" ]; then kill "$server" 2>/dev/null || :; wait "$server" 2>/dev/null || :; fi; rm -f "$directory/input" "$directory/output"' EXIT
  exec 3<> "$directory/input" || return
  codex app-server < "$directory/input" > "$directory/output" 3>&- 2> "$directory/codex.log" &
  server=$!
  exec 4< "$directory/output" || return
  printf '{"id":1,"method":"initialize","params":{"clientInfo":{"name":"lsa","version":"%s"}}}\n' "$VERSION" >&3 || return
  while IFS= read -r -t 30 reply <&4; do
    step=$(jq -r 'if .error then "error: " + .error.message else (.id // "" | tostring) end' <<< "$reply") || return
    case $step in
      1)
        printf '{"method":"initialized","params":{}}\n' >&3 || return
        jq -cn --arg cwd "$PWD" '{id:2,method:"thread/start",params:{cwd:$cwd}}' >&3 || return;;
      2)
        id=$(jq -er '.result.thread.id' <<< "$reply") || return
        jq -cn --arg id "$id" --rawfile text "$snapshot" \
          '{id:3,method:"thread/inject_items",params:{threadId:$id,items:[{type:"message",role:"user",content:[{type:"input_text",text:$text}]}]}}' >&3 || return;;
      3)
        exec 3>&-
        wait "$server" || return
        server=''
        printf '%s\n' "$id"
        return;;
      error:*) echo "lsa: Codex could not load the transcript ($step)" >&2; return 1;;
    esac
  done
  echo "lsa: Codex did not finish loading the transcript; see $directory/codex.log" >&2
  return 1
)

cmd_handoff() {
  local source=$1 hit agent id f cwd target=$2 directory snapshot prompt thread
  case $target in
    claude|codex|pi) ;;
    *) echo "lsa: handoff supports claude, codex or pi (got '$target')" >&2; return 2;;
  esac
  shift 2
  command -v "$target" >/dev/null || { echo "lsa: '$target' is not installed or not on PATH" >&2; return 1; }
  hit=$(find_one "$source") || return
  IFS=$'\t' read -r agent id f cwd <<< "$hit"
  if [ "$agent" != openclaw ] && [ -n "$cwd" ] && [ "$cwd" != - ]; then
    [ -d "$cwd" ] || { echo "lsa: session directory no longer exists: $cwd" >&2; return 1; }
  else cwd=$PWD; fi
  directory=$(umask 077; mkdir -p "$CACHE_DIR/handoffs" && mktemp -d "$CACHE_DIR/handoffs/handoff.XXXXXX") || return
  directory=$(cd "$directory" && pwd -P) || return
  snapshot="$directory/transcript.md"
  (
    umask 077
    printf '# Agent handoff\n\nSource agent: %s\nSession: %s\nProject: %s\nSource store: %s\n\n' "$agent" "$id" "$cwd" "$f" > "$snapshot"
    show_session "$agent" "$id" "$f" "$cwd" >> "$snapshot"
  ) || { rm -rf "$directory"; echo "lsa: could not export the session; handoff cancelled" >&2; return 1; }
  prompt='Continue this conversation from where it left off.'
  cd "$cwd" || return
  printf 'lsa: handing %s session %s to %s\nlsa: saved context: %s\n' "$agent" "$id" "$target" "$snapshot" >&2
  case $target in
    claude) exec claude "$@" "$prompt" < "$snapshot";;
    pi) exec pi "$@" "@$snapshot" "$prompt";;
    codex)
      thread=$(handoff_codex "$directory" "$snapshot") || return
      exec codex resume "$thread" "$@" "$prompt";;
  esac
}

cmd_path() {
  local hit agent id f cwd
  hit=$(find_one "$1") || exit 1
  IFS=$'\t' read -r agent id f cwd <<< "$hit"
  transcript_path "$agent" "$f" "$id"
  printf '%s\n' "$TRANSCRIPT"
}
cmd_resume() {
  local agent id f cwd
  IFS=$'\t' read -r agent id f cwd < <(find_one "$1")
  [ "$cwd" = - ] && cwd=''
  resume_cmd "$agent" "$id" "$f" "$cwd"
  [ -n "$RESUME" ] || { echo "lsa: $agent has no resume command; the session is at" >&2; echo "$f" >&2; exit 1; }
  local target session
  target=$(tmux_target "$id")
  if [ -n "$target" ]; then
    tmux select-window -t "$target" 2>/dev/null || :
    tmux select-pane -t "$target" 2>/dev/null || :
    if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "$target"; fi
    session=$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null)
    exec tmux attach-session -t "$session"
  fi
  # most agents only find a session from the directory it was started in
  [ -d "$cwd" ] && cd "$cwd"
  # shellcheck disable=SC2086
  exec $RESUME
}

# ---------- args ----------
ALL=0 LONG=0 LIMIT=0 AGENTS='' DIR=''
case ${1:-} in
  handoff) [ $# -ge 3 ] || { usage >&2; exit 2; }; shift; cmd_handoff "$@"; exit;;
  show|path|resume) [ $# -eq 2 ] || { usage >&2; exit 2; }; "cmd_$1" "$2"; exit;;
esac
while [ $# -gt 0 ]; do
  case $1 in
    -a|--all) ALL=1;;
    -l|--long) LONG=1;;
    -n|--limit) LIMIT=$2; shift;;
    -t|--agent) AGENTS="$AGENTS $2"; shift;;
    -h|--help) usage; exit 0;;
    -V|--version) echo "lsa $VERSION"; exit 0;;
    -*) echo "lsa: unknown option $1" >&2; usage >&2; exit 2;;
    *) DIR=$1;;
  esac
  shift
done
DIR=$(cd "${DIR:-.}" 2>/dev/null && pwd) || { echo "lsa: no such directory" >&2; exit 1; }
DIRP=$(cd "$DIR" && pwd -P)   # agents may record either the logical or the resolved path
cmd_list "$DIR"
