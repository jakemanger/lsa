    done
    mkdir -p "$tmp/$slug" && printf '%s' "$path" > "$tmp/$slug/.project_root" || return
  fi
  mkdir -p "$tmp/$slug/chats" || return
  sid=$(new_uuid)
  hash=$(printf '%s' "$path" | { shasum -a 256 2>/dev/null || sha256sum; } | cut -c1-64)
  # the name must not end in the session id's first 8 characters: gemini's
  # cleanup deletes every file with that suffix once a resume leaves a stub behind
  jq -c --arg sid "$sid" --arg hash "$hash" --arg now "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" '
    def uid($i): $sid[0:24] + ("00000000000" + ($i | tostring))[-12:];
    {sessionId: $sid, projectHash: $hash, startTime: $now, lastUpdated: $now, kind: "main"},
    (to_entries[] | .key as $i | .value as $m
     # gemini drops user text that starts like a command or its own injected context
     | {id: uid($i), timestamp: $now, type: (if $m.role == "user" then "user" else "gemini" end),
        content: [{text: (if $m.role == "user" and ($m.text | test("^\\s*([/?]|<session_context>|<hook_context>)"))
          then "[message]\n" + $m.text else $m.text end)}]})' \
    "$1/turns.json" > "$1/native.jsonl" &&
    mv "$1/native.jsonl" "$tmp/$slug/chats/session-$(date -u +%Y-%m-%dT%H-%M)-$(new_uuid | cut -c1-8).jsonl" || return
  printf '%s\n' "$sid"
)

# shellcheck disable=SC2016
native_cline() ( # work
  umask 077
  local store="$HOME/.cline/data/sessions" providers="$HOME/.cline/data/settings/providers.json" recent sid dir ms pm
  # shellcheck disable=SC2010,SC2012  # cline ids have no newlines
  recent=$(ls -t "$store"/*/*.json 2>/dev/null | grep -v '\.messages\.json$' | head -n 1)
  if [ -n "$recent" ]; then
    jq -e '.version == 1 and has("session_id") and has("messages_path")' "$recent" >/dev/null ||
      { echo "unrecognised Cline session format" >&2; return 1; }
  fi
  # resume adopts the session's provider and model, so use the ones cline last used
  pm=$(jq -c '.lastUsedProvider as $p | {provider: $p, model: .providers[$p].settings.model}
    | select(.provider and .model)' "$providers" 2>/dev/null)
  [ -n "$pm" ] || { echo "no Cline provider configured" >&2; return 1; }
  ms="$(date +%s)000"
  sid="${ms}_$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 5)"
  dir="$store/$sid"
  mkdir -p "$1/cline" || return
  jq -c --argjson ms "$ms" '{version: 1, updated_at: (($ms / 1000) | todate),
    messages: to_entries | map({id: "msg_lsa_\(.key)", role: .value.role,
      content: [{type: "text", text: .value.text}], ts: ($ms + .key)})}' "$1/turns.json" > "$1/cline/$sid.messages.json" || return
  jq -n --arg sid "$sid" --arg cwd "$(pwd -P)" --argjson pm "$pm" --argjson ms "$ms" \
    --arg messages "$dir/$sid.messages.json" --slurpfile turns "$1/turns.json" '
    ($ms / 1000 | strftime("%Y-%m-%dT%H:%M:%S.000Z")) as $now
    | {version: 1, session_id: $sid, source: "cli", pid: 0, started_at: $now, ended_at: $now, exit_code: 0,
       status: "completed", interactive: true, provider: $pm.provider, model: $pm.model, cwd: $cwd, workspace_root: $cwd,
       enable_tools: true, enable_spawn: false, enable_teams: false, prompt: ($turns[0][0].text | split("\n")[0]),
       metadata: {title: ($turns[0][0].text | split("\n")[0])}, messages_path: $messages}' > "$1/cline/$sid.json" || return
  mkdir -p "$store" && mv "$1/cline" "$dir" || return
  printf '%s\n' "$sid"
)

# opencode imports its own export format
# shellcheck disable=SC2016
native_opencode() ( # work
  umask 077
  local version id model
  version=$(opencode --version 2>/dev/null | awk '{ print $NF }')
  [ -n "$version" ] || { echo "could not read the OpenCode version" >&2; return 1; }
  # new sessions and resumes use the configured model; imported messages only need one to name
  model=$(jq -r '.model // empty' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" 2>/dev/null)
  model=${model:-opencode/handoff}
  jq --arg cwd "$(pwd -P)" --arg version "$version" --arg model "$model" --argjson ms "$(date +%s)000" \
    --arg rand "$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 14)" '
    # opencode ids: prefix_ + 12 hex digits of ms*4096+counter + 14 random characters;
    # session ids are inverted so the newest sorts first
    def hex12: . as $n | [range(11; -1; -1) as $k | ($n / pow(16; $k) | floor) | . - 16 * (. / 16 | floor)]
      | map("0123456789abcdef"[.:. + 1]) | join("");
    def oid($prefix; $n): $prefix + "_" + ($n | hex12) + $rand;
    ($ms * 4096) as $base | oid("ses"; 281474976710655 - $base) as $ses
    | ($model | split("/")) as $pm | {providerID: $pm[0], modelID: ($pm[1:] | join("/"))} as $m
    | {info: {id: $ses, slug: "lsa-handoff", projectID: "global", directory: $cwd, version: $version,
        title: (.[0].text | split("\n")[0]), time: {created: $ms, updated: $ms}},
       messages: [to_entries[] | .key as $i | .value as $t | oid("msg"; $base + 2 * $i + 1) as $msg
         | {info: ({id: $msg, sessionID: $ses, role: $t.role, time: {created: ($ms + $i)}, agent: "build"}
             + if $t.role == "user" then {model: $m}
               else {time: {created: ($ms + $i), completed: ($ms + $i)}, parentID: oid("msg"; $base + 2 * $i - 1),
                 modelID: $m.modelID, providerID: $m.providerID, mode: "build", path: {cwd: $cwd, root: $cwd},
                 cost: 0, tokens: {input: 0, output: 0, reasoning: 0, cache: {read: 0, write: 0}}, finish: "stop"} end),
            parts: [{id: oid("prt"; $base + 2 * $i + 2), sessionID: $ses, messageID: $msg, type: "text", text: $t.text}]}]}' \
    "$1/turns.json" > "$1/opencode.json" || return
  id=$(jq -r .info.id "$1/opencode.json")
  opencode import "$1/opencode.json" >"$1/opencode.log" 2>&1 ||
    { echo "opencode could not import the session: $(tail -n 1 "$1/opencode.log")" >&2; return 1; }
  printf '%s\n' "$id"
)

handoff_resume() { # target session [options...]
  local target=$1 session=$2
  shift 2
  case $target in
    claude) exec claude --resume "$session" "$@";;
    codex) exec codex resume "$session" "$@";;
    pi) exec pi --session "$session" "$@";;
    gemini) exec gemini --resume "$session" "$@";;
    qwen) exec qwen --resume "$session" "$@";;
    cline) exec cline -i --id "$session" "$@";;
    opencode) exec opencode --session "$session" "$@";;
    goose) exec goose session --resume --session-id "$session" --history "$@";;
    muse) exec muse resume "$session" "$@";;
    openclaw) exec openclaw chat --session "$session" "$@";;
  esac
}

# the fallback: an interactive session that opens with the whole transcript
# as its first message. Agents that only take it as an argument get the most
# recent part when it is too long for one.
handoff_first() { # target work [options...]
  local target=$1 file="$2/transcript.md" prompt text
  shift 2
  prompt="That is our conversation so far, from another agent. Pick up where it left off: say where things stand, then wait for my next message."
  text=$(tail -c 100000 "$file"; printf '\n\n%s' "$prompt")
  case $target in
    claude) exec claude "$@" "$prompt" < "$file";;
    pi) exec pi "$@" "@$file" "$prompt";;
    codex) exec codex "$@" "$text";;
    gemini) exec gemini "$@" -i "$text";;
    qwen) exec qwen "$@" -i "$text";;
    cline) exec cline "$@" -i "$text";;
    opencode) exec opencode "$@" --prompt "$prompt" < "$file";;
    goose) printf '%s\n\n%s\n' "$(cat "$file")" "$prompt" > "$file.goose" && exec goose run "$@" -s -i "$file.goose";;
    muse) exec muse "$@" "$text";;
    openclaw)
      set -- --session "agent:main:lsa-$(new_uuid | cut -c1-8)" --message "$text" "$@"
      if openclaw_gateway; then exec openclaw tui "$@"; else exec openclaw chat "$@"; fi;;
  esac
}

cmd_handoff() {
  local source=$1 hit agent id f cwd target=$2 work session
  case " $HANDOFF_AGENTS " in
    *" $target "*) ;;
    *) echo "lsa: handoff supports $HANDOFF_AGENTS (got '$target')" >&2; return 2;;
  esac
  shift 2
  command -v "$target" >/dev/null || { echo "lsa: '$target' is not installed or not on PATH" >&2; return 1; }
  hit=$(find_one "$source") || return
  IFS=$'\t' read -r agent id f cwd <<< "$hit"
  if [ "$agent" != openclaw ] && [ -n "$cwd" ] && [ "$cwd" != - ]; then
    [ -d "$cwd" ] || { echo "lsa: session directory no longer exists: $cwd" >&2; return 1; }
  else cwd=$PWD; fi
  work=$(mktemp -d "${TMPDIR:-/tmp}/lsa-handoff.XXXXXX") || return
  { handoff_turns "$agent" "$id" "$f" "$cwd" > "$work/turns.json" &&
    printf '# Conversation continued from %s session %s\n' "$agent" "$id" > "$work/transcript.md" &&
    show_session "$agent" "$id" "$f" "$cwd" >> "$work/transcript.md"; } ||
    { rm -rf "$work"; echo "lsa: could not export the session; handoff cancelled" >&2; return 1; }
  cd "$cwd" || return
  # best: write the conversation as the agent's own session and resume it, like lsa resume
  if session=$("native_$target" "$work" 2>"$work/error"); then
    rm -rf "$work"
    printf 'lsa: copied %s session %s into a new %s session\n' "$agent" "$id" "$target" >&2
    handoff_resume "$target" "$session" "$@"
  fi
  # otherwise: open the agent with the conversation as its first message
  printf 'lsa: could not write a native %s session (%s); sending the conversation as the first message\n' \
    "$target" "$(head -n 1 "$work/error")" >&2
  handoff_first "$target" "$work" "$@"
}
cmd_path() {
  local hit agent id f cwd
  hit=$(find_one "$1") || exit 1
  IFS=$'\t' read -r agent id f cwd <<< "$hit"
  transcript_path "$agent" "$f" "$id"
  printf '%s\n' "$TRANSCRIPT"
}
cmd_resume() {
  local agent id f cwd
  IFS=$'\t' read -r agent id f cwd < <(find_one "$1")
  [ "$cwd" = - ] && cwd=''
  resume_cmd "$agent" "$id" "$f" "$cwd"
  [ -n "$RESUME" ] || { echo "lsa: $agent has no resume command; the session is at" >&2; echo "$f" >&2; exit 1; }
  local target session
  target=$(tmux_target "$id")
  if [ -n "$target" ]; then
    tmux select-window -t "$target" 2>/dev/null || :
    tmux select-pane -t "$target" 2>/dev/null || :
    if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "$target"; fi
    session=$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null)
    exec tmux attach-session -t "$session"
  fi
  # most agents only find a session from the directory it was started in
  [ -d "$cwd" ] && cd "$cwd"
  # shellcheck disable=SC2086
  exec $RESUME
}

# ---------- args ----------
ALL=0 LONG=0 LIMIT=0 AGENTS='' DIR=''
case ${1:-} in
  handoff) [ $# -ge 3 ] || { usage >&2; exit 2; }; shift; cmd_handoff "$@"; exit;;
  show|path|resume) [ $# -eq 2 ] || { usage >&2; exit 2; }; "cmd_$1" "$2"; exit;;
esac
while [ $# -gt 0 ]; do
  case $1 in
    -a|--all) ALL=1;;
    -l|--long) LONG=1;;
    -n|--limit) LIMIT=$2; shift;;
    -t|--agent) AGENTS="$AGENTS $2"; shift;;
    -h|--help) usage; exit 0;;
    -V|--version) echo "lsa $VERSION"; exit 0;;
    -*) echo "lsa: unknown option $1" >&2; usage >&2; exit 2;;
    *) DIR=$1;;
  esac
  shift
done
DIR=$(cd "${DIR:-.}" 2>/dev/null && pwd) || { echo "lsa: no such directory" >&2; exit 1; }
DIRP=$(cd "$DIR" && pwd -P)   # agents may record either the logical or the resolved path
cmd_list "$DIR"
