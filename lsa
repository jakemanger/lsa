# shellcheck disable=SC2016
native_openclaw() ( # work
  umask 077
  local db="$HOME/.openclaw/agents/main/agent/openclaw-agent.sqlite" sid key
  [ -f "$db" ] || { echo "no OpenClaw agent database" >&2; return 1; }
  # a running gateway keeps its own copy of sessions and blocks local chat
  openclaw_gateway && { echo "an OpenClaw gateway is running" >&2; return 1; }
  # openclaw migrates older databases and refuses newer ones, so only write the version this matches
  [ "$(sqlite3 -readonly "$db" 'pragma user_version' 2>/dev/null)" = 21 ] ||
    { echo "unrecognised OpenClaw database version" >&2; return 1; }
  sid=$(new_uuid)
  key="agent:main:lsa-${sid:0:8}"
  jq -r --arg sid "$sid" --arg key "$key" --arg cwd "$HOME/.openclaw/workspace" --arg now "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" \
    --argjson ms "$(date +%s)000" --arg ids "$(new_uuid)" '
    def sq: "'"'"'" + gsub("'"'"'"; "'"'"''"'"'") + "'"'"'";
    def uid($n): $ids[0:24] + ("00000000000" + ($n | tostring))[-12:];
    def event($seq; $e): "insert into transcript_events (session_id, seq, event_json, created_at) values (\($sid | sq), \($seq), \($e | tojson | sq), \($ms));";
    "begin immediate;",
    "insert into session_nodes (session_key, current_session_id, entry_json, updated_at) values (\($key | sq), \($sid | sq), \({sessionId: $sid, updatedAt: $ms, chatType: "direct"} | tojson | sq), \($ms));",
    # an insert trigger marks new rows for repair; this is the row openclaw would write
    "update session_nodes set entry_valid = 1 where session_key = \($key | sq);",
    "insert into session_windows (session_id, session_key, created_at, updated_at, reason, chat_type) values (\($sid | sq), \($key | sq), \($ms), \($ms), '"'"'initial'"'"', '"'"'direct'"'"');",
    event(0; {type: "session", version: 4, id: $sid, timestamp: $now, cwd: $cwd}),
    (to_entries[] | .key as $i | .value as $m
     | event($i + 1; {type: "message", id: uid($i), parentId: (if $i == 0 then null else uid($i - 1) end), timestamp: $now,
         message: ({role: $m.role, timestamp: $ms}
           + if $m.role == "user" then {content: $m.text}
             else {content: [{type: "text", text: $m.text}], stopReason: "stop", api: "lsa", provider: "lsa", model: "handoff",
               usage: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,
                 cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0}}} end)})),
    "commit;"' "$1/turns.json" > "$1/openclaw.sql" || return
  sqlite3 -bail -cmd '.timeout 5000' "$db" < "$1/openclaw.sql" >/dev/null || return
  printf '%s\n' "$key"
)

