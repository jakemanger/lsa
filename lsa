# shellcheck disable=SC2016
native_muse() ( # work
  umask 077
  local root="${XDG_DATA_HOME:-$HOME/.local/share}/muse/sessions" sid dir recent line
  recent=$(newest "$root"/*/*/*/*/session.jsonl)
  if [ -n "$recent" ]; then
    for line in '"kind":"started"|prompt' '"kind":"assistant_message_committed"|text'; do
      grep -m 1 "${line%|*}" "$recent" | jq -e --arg key "${line#*|}" '.schema_version == 1 and (.payload.event | has($key))' >/dev/null ||
        { grep -q "${line%|*}" "$recent" && { echo "unrecognised Muse session format" >&2; return 1; }; }
    done
  fi
  sid=$(new_uuid)
  dir="$root/$(date +%Y/%m/%d)/$sid"
  mkdir -p "$dir" || return
  # one run per user message: started, the assistant reply, then terminal.
  # No session.end: muse refuses to resume one without its permission record.
  jq -c --arg cwd "$(pwd -P)" --arg sid "$sid" --arg ids "$(new_uuid)" --arg runs "$(new_uuid)" --argjson us "$(date +%s)000000" '
    def uid($base; $n): $base[0:24] + ("00000000000" + ($n | tostring))[-12:];
    def run($r; $event): {type: "runtime.session", payload: {kind: "run", run_id: $r, event: $event}};
    [{type: "runtime.session.metadata", payload: {kind: "metadata", record: {workspace_root: $cwd}}}]
    + [range(0; length; 2) as $i | .[$i] as $u | .[$i + 1] as $a | uid($runs; $i) as $r
       | run($r; {kind: "started", prompt: $u.text}),
         (if $a then run($r; {kind: "assistant_message_committed", message_id: uid($runs; $i + 1),
           response_id: "lsa-handoff", text: $a.text}) else empty end),
         run($r; {kind: "terminal", terminal: "completed", reason: null})]
    | to_entries[] | (.key + 1) as $n
    | {schema_version: 1, id: uid($ids; $n), stream: {kind: "session", id: $sid}, sequence: $n,
       recorded_at: ($us + $n), record_type: "event", durability: "durable", causation_id: null,
       payload_type: .value.type, payload_schema_version: 1, payload: .value.payload}' \
    "$1/turns.json" > "$1/native.jsonl" && mv "$1/native.jsonl" "$dir/session.jsonl" || return
  printf '%s\n' "$sid"
)

