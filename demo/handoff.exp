#!/usr/bin/expect -f
# a real interactive handoff: Claude resumes the Goose conversation as its own
# play.sh runs Claude with no tools and the normal login.
source [file join [file dirname [info script]] agent.tcl]
encoding system utf-8
set trust_sent 0
spawn -noecho bash -c {lsa handoff 2026 claude}

expect_before {
    -re {\x1b\[6n} { send "\033\[1;1R"; exp_continue }
    -re {Enter.*confirm} {
        if {!$trust_sent} {
            set trust_sent 1
            sleep 0.5
            send "\033\[B"
            sleep 0.2
            send "\033\[13u"
        }
        exp_continue
    }
}

# the title is set before the history draws; wait for the prompt footer, which
# comes after it, then hold the loaded conversation on screen before typing
wait_for {shortcuts}
pause 3.5
type "Make the release notes one sentence."
pause 0.4
send "\033\[13u"
wait_for {⏺}
wait_for {\x1b\]0;✳}
pause 5

# quit Claude on camera, as a person would
send "\003"
pause 0.5
send "\003"
expect -timeout 10 eof
